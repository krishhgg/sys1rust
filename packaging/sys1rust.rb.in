# Generated by packaging/render_formula.sh in krishhgg/sys1rust for each release.
# The next release overwrites edits here.
class Sys1rust < Formula
  desc "Laya System 1 decision server for Apple silicon, in Rust and Metal"
  homepage "https://github.com/krishhgg/sys1rust"
  version "@VERSION@"
  license "Apache-2.0"

  depends_on arch: :arm64
  depends_on macos: :sonoma

  # MLX's build for macOS 26.2 and later is about 3x faster on the M5 than its macOS 14 build.
  # on_macos keeps the MacOS call off Linux, where brew style rejects it.
  on_macos do
    if MacOS.full_version >= "26.2"
      url "@BASE_URL@/sys1rust-@VERSION@-macos26-arm64.tar.gz"
      sha256 "@SHA256_MACOS26@"
    else
      url "@BASE_URL@/sys1rust-@VERSION@-macos14-arm64.tar.gz"
      sha256 "@SHA256_MACOS14@"
    end
  end

  def install
    libexec.install Dir["*"]
    bin.install_symlink libexec/"bin/sys1rust"
  end

  def caveats
    <<~EOS
      The first `sys1rust serve` downloads the typed-decisions model (846 MB) into the
      Hugging Face cache (~/.cache/huggingface/hub). `sys1rust pull` downloads it ahead of time.

      The first start after an install or upgrade compiles Metal shaders for about 1.7 s.

      The `brew services start` command below runs the server on 127.0.0.1:8000.
    EOS
  end

  service do
    run [opt_bin/"sys1rust", "serve"]
    keep_alive true
    log_path var/"log/sys1rust.log"
    error_log_path var/"log/sys1rust.log"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/sys1rust --version")
    assert_match "typed-decisions", shell_output("#{bin}/sys1rust models")
  end
end
